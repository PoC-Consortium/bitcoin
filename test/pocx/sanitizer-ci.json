    "ENABLE_WALLET": "ON",
    "ENABLE_IPC": "ON",
    "WITH_QRENCODE": "ON",
    "WITH_USDT": "ON",
    "WITH_ZMQ": "ON",
    "BUILD_TESTS": "ON",
