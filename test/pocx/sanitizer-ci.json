    "UBSAN_OPTIONS": "suppressions={root}/test/sanitizer_suppressions/ubsan:print_stacktrace=1:halt_on_error=1:report_error_type=1",
    "ASAN_SYMBOLIZER_PATH": "/usr/bin/llvm-symbolizer-22"
