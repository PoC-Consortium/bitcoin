# Preserve the upstream base-install recipe while making owned environment
# wrappers and their original source scripts available at their declared paths.
ARG CI_IMAGE_NAME_TAG=scratch
FROM ${CI_IMAGE_NAME_TAG} AS runtime-inputs

ARG FILE_ENV
ENV FILE_ENV=${FILE_ENV}
ARG BASE_ROOT_DIR
ENV BASE_ROOT_DIR=${BASE_ROOT_DIR}

COPY ./ci/retry/retry /usr/bin/retry
COPY ./ci/test/00_setup_env*.sh ./ci/test/01_base_install.sh ./ci/test/01_iwyu.patch /ci_container_base/ci/test/
COPY ./test/pocx/ci/ /ci_container_base/test/pocx/ci/

FROM runtime-inputs
RUN sh -c "bash -c 'true' || ( apk update && apk add --no-cache bash )"
RUN ["bash", "-c", "cd /ci_container_base/ && set -o errexit && source ./ci/test/00_setup_env.sh && ./ci/test/01_base_install.sh"]
